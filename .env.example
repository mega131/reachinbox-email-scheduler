# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:1234@localhost:5432/reachinbox_db?schema=public"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379"

# Server Configuration
PORT=4000
API_BASE_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"

# Security & Encryption Secrets (minimum 32 characters for AES-256)
SESSION_SECRET="reachinbox_session_secret_key_prod_32chars_min"
ENCRYPTION_SECRET="0123456789abcdef0123456789abcdef"

# Google OAuth 2.0 Credentials
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Slack OAuth Credentials
# Get these from https://api.slack.com/apps
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:4000/api/slack/callback"
SLACK_SIGNING_SECRET=""

# Elasticsearch Configuration
ELASTICSEARCH_NODE="http://localhost:9200"

# Ethereal Email SMTP Credentials (Auto-generated if left blank)
ETHEREAL_USER=""
ETHEREAL_PASS=""

# Outreach Rate Limiting & Scheduling Controls
DEFAULT_MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=200
WORKER_CONCURRENCY=5
